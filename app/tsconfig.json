{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": false,
    "types": [
      "vite/client"
    ],
    "paths": {
      "moodence": [
        "../packages/moodence/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
