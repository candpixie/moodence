  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter moodence-app dev",
    "build": "pnpm --filter moodence build && pnpm --filter moodence-app build && pnpm --filter moodence apidocs",
